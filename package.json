{
  "name": "relocscraper",
  "version": "1.0.0",
  "description": "CLI tool to automatically scrape, display, filter and sort rental relocations across Europe (indiecampers.com, movacar.de, driiveme.com, imoova.com, carlundcarla.de)",
  "type": "module",
  "bin": {
    "reloc": "./bin/reloc.mjs"
  },
  "scripts": {
    "start": "node bin/reloc.mjs",
    "scan": "node bin/reloc.mjs scan",
    "display": "node bin/reloc.mjs display",
    "filter": "node bin/reloc.mjs filter",
    "sort": "node bin/reloc.mjs sort",
    "stats": "node bin/reloc.mjs stats",
    "watch": "node bin/reloc.mjs watch",
    "export": "node bin/reloc.mjs export",
    "test": "node tests/test-all.mjs"
  },
  "keywords": [
    "relocation",
    "campervan",
    "rental",
    "cli",
    "scraper",
    "europe",
    "one-way",
    "driiveme",
    "movacar",
    "imoova",
    "indiecampers",
    "carlundcarla"
  ],
  "author": "Antigravity & Checker",
  "license": "MIT",
  "dependencies": {
    "js-yaml": "^5.3.0"
  }
}
